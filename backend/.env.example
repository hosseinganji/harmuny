APP_NAME="Harmony"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Several workers so a streaming song does not block other requests in `php artisan serve`.
PHP_CLI_SERVER_WORKERS=6

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_music
DB_USERNAME=smart_music
DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must be longer than the longest queue:work --timeout (3600 s), or long jobs run twice and fail.
DB_QUEUE_RETRY_AFTER=3700

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Harmony ---
# Server-side audio cache limit (MB); 0 = keep every song. Above the limit, least recently played files are pruned.
MUSIC_CACHE_MAX_MB=0
# Download every song from Telegram to this server in the background (checked every 10 minutes).
MUSIC_PREFETCH=true
# Pause downloading when free disk space drops below this (MB).
MUSIC_MIN_FREE_MB=2048
# Minutes between automatic Telegram channel syncs.
TELEGRAM_SYNC_INTERVAL=10
LYRICS_ENABLED=true
# Optional: `php artisan db:seed` creates this admin. Otherwise the first registered user becomes admin.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Optional proxy to reach Telegram from a filtered network, e.g. socks5h://127.0.0.1:1080
TELEGRAM_PROXY=
# Optional MTProxy link for the user-account mode, e.g. https://t.me/proxy?server=...&port=...&secret=...
TELEGRAM_MTPROXY=
