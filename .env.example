# Copy to .env and fill in, then: docker compose up -d --build

# Your domain; Caddy gets a Let's Encrypt certificate automatically (DNS must point here).
DOMAIN=music.example.com
# Contact address for the HTTPS certificate (Let's Encrypt / ZeroSSL).
ACME_EMAIL=

APP_NAME="Harmony"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://music.example.com
# Generate with: docker compose run --rm app php artisan key:generate --show
APP_KEY=

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=smart_music
DB_USERNAME=smart_music
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
# Must be longer than the longest queue:work --timeout (3600 s), or long jobs run twice and fail.
DB_QUEUE_RETRY_AFTER=3700

# Server-side audio cache limit (MB); least recently played files are removed first.
MUSIC_CACHE_MAX_MB=0
MUSIC_PREFETCH=true
MUSIC_MIN_FREE_MB=2048
# Minutes between automatic Telegram syncs.
TELEGRAM_SYNC_INTERVAL=10
LYRICS_ENABLED=true

# Optional: created/updated on every start. Otherwise the first registered user becomes admin.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Optional proxy to reach Telegram from a filtered network, e.g. socks5h://127.0.0.1:1080
TELEGRAM_PROXY=
# Optional MTProxy link for the user-account mode, e.g. https://t.me/proxy?server=...&port=...&secret=...
TELEGRAM_MTPROXY=
