{
	frankenphp {
		# Song downloads keep a PHP thread busy for the whole transfer; the default (2 per CPU) is far too few.
		num_threads 24
	}
	# With an email Caddy falls back to ZeroSSL when Let's Encrypt refuses (e.g. its per-domain rate limit).
	email {$ACME_EMAIL}
}

{$SERVER_NAME:localhost} {
	# www.example.com → example.com: one address, so an installed app keeps a single offline store.
	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} permanent

	# Live updates (Server-Sent Events) are streamed as they are, never held back for compression.
	@compressible not path /.well-known/mercure*
	encode @compressible zstd gzip

	# Mercure hub: Jams publish their changes here (mercure_publish) and members' devices listen.
	# Updates are private: a device needs a token for its Jam's topic, which the API hands to members.
	handle /.well-known/mercure* {
		mercure {
			publisher_jwt {env.MERCURE_PUBLISHER_JWT_KEY}
			subscriber_jwt {env.MERCURE_SUBSCRIBER_JWT_KEY}
			# The Android app runs on its own origin; tokens travel in the URL, so no cookies are involved.
			cors_origins *
		}
	}

	# Laravel API (and the /up health check).
	@backend path /api/* /up
	handle @backend {
		root * /app/public
		php_server
	}

	# The Vue PWA. Hashed assets are immutable; the service worker must always revalidate.
	handle {
		root * /app/spa
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@sw path /sw.js /registerSW.js /manifest.webmanifest /index.html /version.json
		header @sw Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
